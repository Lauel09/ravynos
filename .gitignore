# Reverse-engineering scratch: rea/Ghidra projects are large and machine
# specific.  Evidence that matters is committed as small JSON + provenance.
work/**/ghidra-project/
work/**/*.gpr
work/**/*.rep

# Python bytecode from the pipeline's test runs
__pycache__/
*.pyc

# Kernel/UEFI build outputs (KERNEL.ELF is a checked-in test fixture)
*.o
*.obj
/tools/bootloader/BOOTX64.EFI
/tools/shell/SHELL.EFI
